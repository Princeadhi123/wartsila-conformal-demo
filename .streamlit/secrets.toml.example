# Optional LLM advisory endpoint for the demo app.
#
# Local run: copy this file to .streamlit/secrets.toml (git-ignored) or set
# the same names as environment variables — env vars take precedence.
# Streamlit Community Cloud: paste these keys into
# Manage app -> Settings -> Secrets (root level, not inside a section).
#
# Never commit or paste a real token into git, issues or chat; rotate any
# token that has been exposed.

UAA_LLM_BASE_URL = "https://aitta-api.csc.fi/openai/v1"
UAA_LLM_MODEL = "openai/gpt-oss-120b"
UAA_LLM_API_KEY = "paste-your-aitta-token-here"  # AITTA_KEY also accepted
